local function getScreenGui()
    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
    return pgui and pgui:FindFirstChild("ScreenGui")
end

local function getSlapButton()
    local sg = getScreenGui()
    return sg and sg:FindFirstChild("slapbut")
end

local function getDodgeButton()
    local sg = getScreenGui()
    return sg and sg:FindFirstChild("dodgebut")
end

local function getMeterFrame()
    local sg = getScreenGui()
    return sg and sg:FindFirstChild("meter")
end

local function isDodgePromptActive(btn)
    btn = btn or getDodgeButton()
    if not btn or not btn.Visible then return false end
    local absSize = btn.AbsoluteSize
    if absSize.X < 5 or absSize.Y < 5 then return false end
    if btn.TextTransparency and btn.TextTransparency >= 0.95 and btn.BackgroundTransparency >= 0.95 then
        return false
    end
    return true
end

local function isMeterActive(meter)
    meter = meter or getMeterFrame()
    if not meter or not meter.Visible then return false end
    local absSize = meter.AbsoluteSize
    if absSize.Y < 30 then return false end
    return true
end

local function getButtonCombinedText(btn)
    if not btn then return "" end
    local fullText = btn.Text or ""
    for _, child in ipairs(btn:GetChildren()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") then
            fullText = fullText .. " " .. (child.Text or "")
        end
    end
    return fullText:lower()
end

-- ตรวจสอบว่าปุ่ม SLAP พร้อมให้กดจริงหรือไม่ (อิงจากปุ่ม slapbut ตัวจริงเท่านั้น ไม่พึ่งพา meter)
local function isSlapPromptActive()
    local sg = getScreenGui()
    if not sg then return false end
    
    -- ถ้าเปิดหน้าจอทาย suspects อยู่ แปลว่าไม่ได้อยู่ในช่วงตบ
    local suspects = sg:FindFirstChild("suspects")
    if suspects and suspects.Visible then
        return false
    end
    
    local btn = sg:FindFirstChild("slapbut")
    if not btn or not btn.Visible then
        return false
    end
    
    local absSize = btn.AbsoluteSize
    if absSize.X < 15 or absSize.Y < 15 then
        return false
    end
    
    local pos = btn.AbsolutePosition
    if pos.X < -50 or pos.Y < -50 then
        return false
    end
    
    local txt = getButtonCombinedText(btn)
    -- ถ้ามีคำว่า Wait... แปลว่ายังไม่ถึงคิวตบ
    if string.find(txt, "wait") then
        return false
    end
    
    return true
end

local function isPlayerSittingInArena(player)
    if not player or not player.Character then return false end
    local hum = player.Character:FindFirstChild("Humanoid")
    if hum and hum.Sit and hum.SeatPart then
        local seat = hum.SeatPart
        if seat.Name == "Seat" and seat.Parent and seat.Parent.Name == "Chair" then
            return true
        end
    end
    return false
end

local function getCurrentArena()
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myHRP and myHRP.Position or (workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position)
    if not myPos then return nil end
    
    local arenas = workspace:FindFirstChild("arenas")
    if not arenas then return nil end
    
    local closestArena = nil
    local closestDist = math.huge
    for _, arena in ipairs(arenas:GetChildren()) do
        local seat = arena:FindFirstChild("Chair") and arena.Chair:FindFirstChild("Seat")
        if seat then
            local dist = (seat.Position - myPos).Magnitude
            if dist < closestDist and dist <= 45 then
                closestDist = dist
                closestArena = arena
            end
        end
    end
    return closestArena
end

