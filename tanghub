-- สแกนคนตบจากสังเวียนจริง
local function scanArenaForSlapper()
    local arena = getCurrentArena()
    if not arena then return end
    
    local seat = arena:FindFirstChild("Chair") and arena.Chair:FindFirstChild("Seat")
    if not seat then return end
    
    local suspects = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if not isPlayerSittingInArena(p) then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - seat.Position).Magnitude <= 25 then
                    table.insert(suspects, p)
                end
            end
        end
    end
    
    if #suspects == 1 then
        setIdentifiedSlapper(suspects[1], "Solo Suspect")
        return
    end
    
    for _, p in ipairs(suspects) do
        local hum = p.Character:FindFirstChild("Humanoid")
        local animator = hum and hum:FindFirstChildWhichIsA("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track.IsPlaying and track.Animation then
                    local aName = track.Animation.Name:lower()
                    if string.find(aName, "slap") or string.find(aName, "punch") or string.find(aName, "kick") then
                        setIdentifiedSlapper(p, "Attack Animation")
                        return
                    end
                end
            end
        end
    end
end

local function parsePlayerFromArg(arg)
    if not arg then return nil end
    if typeof(arg) == "Instance" then
        if arg:IsA("Player") then return arg end
        if arg:IsA("Model") and Players:GetPlayerFromCharacter(arg) then
            return Players:GetPlayerFromCharacter(arg)
        end
    elseif typeof(arg) == "string" and #arg > 0 then
        local p = Players:FindFirstChild(arg)
        if p then return p end
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.DisplayName:lower() == arg:lower() or pl.Name:lower() == arg:lower() then
                return pl
            end
        end
    elseif typeof(arg) == "table" then
        for _, v in pairs(arg) do
            local found = parsePlayerFromArg(v)
            if found then return found end
        end
    end
    return nil
end

local function handleCombatRemote(...)
    hasNotifiedAttackerThisRound = false -- เริ่มการตบรอบใหม่ รีเซ็ตให้แจ้งเตือนได้
    for _, a in ipairs({...}) do
        local p = parsePlayerFromArg(a)
        if p and p ~= LocalPlayer and not isPlayerSittingInArena(p) then
            setIdentifiedSlapper(p, "Combat Remote")
            return
        end
    end
end

if Remotes.ShowSlap then Remotes.ShowSlap.OnClientEvent:Connect(handleCombatRemote) end
if Remotes.SlapQueue then Remotes.SlapQueue.OnClientEvent:Connect(handleCombatRemote) end

