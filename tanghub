local lastGuessedTarget = nil
local function checkAndHighlightSuspects()
    local sg = getScreenGui()
    if not sg then return end
    
    local suspectsFrame = sg:FindFirstChild("suspects")
    if not suspectsFrame or not suspectsFrame.Visible then 
        if lastGuessedTarget ~= nil then
            -- เมื่อปิดป้ายทาย แปลว่าจบรอบแล้ว รีเซ็ตสถานะทั้งหมดเพื่อเตรียมพร้อมสำหรับรอบถัดไป
            lastGuessedTarget = nil
            hasNotifiedAttackerThisRound = false
            lastIdentifiedSlapper = nil
            clearAttackerESP()
        end
        return 
    end
    
    if not lastIdentifiedSlapper or tick() - lastIdentifiedTime > 20 then
        scanArenaForSlapper()
        if not lastIdentifiedSlapper then return end
    end
    
    local targetName = (lastIdentifiedSlapper.Name):lower()
    local targetDisplay = (lastIdentifiedSlapper.DisplayName):lower()
    
    for _, item in ipairs(suspectsFrame:GetDescendants()) do
        if item:IsA("TextLabel") or item:IsA("TextButton") then
            local txt = item.Text:lower()
            if string.find(txt, targetName) or string.find(txt, targetDisplay) then
                local cardBtn = item:FindFirstAncestorWhichIsA("GuiButton") or (item:IsA("GuiButton") and item)
                if cardBtn then
                    if Config.HighlightSuspectCard then
                        cardBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
                        local stroke = cardBtn:FindFirstChildWhichIsA("UIStroke") or Instance.new("UIStroke")
                        stroke.Color = Color3.fromRGB(0, 255, 128)
                        stroke.Thickness = 4
                        stroke.Parent = cardBtn
                    end
                    
                    if Config.AutoGuess and lastGuessedTarget ~= lastIdentifiedSlapper then
                        lastGuessedTarget = lastIdentifiedSlapper
                        if firesignal then
                            firesignal(cardBtn.MouseButton1Click)
                        elseif VirtualInputManager then
                            local pos = cardBtn.AbsolutePosition + (cardBtn.AbsoluteSize / 2)
                            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                            task.wait(0.02)
                            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                        end
                        pcall(function() Remotes.Guess:FireServer(lastIdentifiedSlapper) end)
                        pcall(function() Remotes.Guess:FireServer(lastIdentifiedSlapper.Name) end)
                        showBanner("🎯 ทายคนตบ: [" .. lastIdentifiedSlapper.DisplayName .. "] สำเร็จ!", Color3.fromRGB(46, 204, 113), 3.5)
                    end
                    break
                end
            end
        end
    end
end

