-- 9. AUTO DODGE (WASD SUPPORT)
-- ------------------------------------------------------------------------------
local keyMap = {
    ["W"] = { KeyCode = Enum.KeyCode.W, VKey = 0x57 },
    ["A"] = { KeyCode = Enum.KeyCode.A, VKey = 0x41 },
    ["S"] = { KeyCode = Enum.KeyCode.S, VKey = 0x53 },
    ["D"] = { KeyCode = Enum.KeyCode.D, VKey = 0x44 },
}

local function detectDodgeKey(btn)
    btn = btn or getDodgeButton()
    if not btn then return "D" end
    
    local txt = btn.Text
    if txt and #txt > 0 then
        local match = string.match(txt:upper(), "[WASD]")
        if match then return match end
    end
    
    for _, child in ipairs(btn:GetDescendants()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") then
            local ctxt = child.Text
            if ctxt and #ctxt > 0 then
                local match = string.match(ctxt:upper(), "[WASD]")
                if match then return match end
            end
        end
    end
    
    local psIcons = btn:FindFirstChild("psIcons")
    if psIcons then
        local triangle = psIcons:FindFirstChild("psTriangle")
        local square = psIcons:FindFirstChild("psSquare")
        local cross = psIcons:FindFirstChild("psCross")
        local circle = psIcons:FindFirstChild("psCircle")
        
        if triangle and triangle.Visible then return "W" end
        if square and square.Visible then return "A" end
        if cross and cross.Visible then return "S" end
        if circle and circle.Visible then return "D" end
    end
    
    return "D"
end

local hasDodgedThisPrompt = false
local function executeDodge()
    if hasDodgedThisPrompt then return end
    hasDodgedThisPrompt = true
    
    local btn = getDodgeButton()
    local keyChar = detectDodgeKey(btn)
    local keyData = keyMap[keyChar] or keyMap["D"]
    
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyData.KeyCode, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, keyData.KeyCode, false, game)
    end)
    
    if keypress and keyrelease then
        pcall(function()
            keypress(keyData.VKey)
            task.wait(0.02)
            keyrelease(keyData.VKey)
        end)
    end
    
    if btn then
        pcall(function()
            local pos = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
        end)
        if firesignal then
            pcall(function() firesignal(btn.MouseButton1Click) end)
            pcall(function() firesignal(btn.Activated) end)
        end
    end
    
    pcall(function() Remotes.Dodge:FireServer(keyChar) end)
    pcall(function() Remotes.Dodge:FireServer() end)
    pcall(function() Remotes.DodgeResult:FireServer(true, keyChar) end)
    pcall(function() Remotes.DodgeResult:FireServer(true) end)
    pcall(function() Remotes.DodgePrompt:FireServer(keyChar) end)
    
    showBanner("⚡ หลบการโจมตีสำเร็จ! (กดปุ่ม " .. keyChar .. ")", Color3.fromRGB(50, 220, 120), 2)
end

-- เชื่อมต่อการนั่ง/ลุกเพื่อรีเซ็ตสถานะอย่างแม่นยำ
local function setupCharacter(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        hum:GetPropertyChangedSignal("Sit"):Connect(function()
            hasSlappedThisTurn = false
            isSlappingNow = false
            hasNotifiedAttackerThisRound = false
            if not hum.Sit then
                clearAttackerESP()
                lastIdentifiedSlapper = nil
            end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(setupCharacter)
if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end

-- ------------------------------------------------------------------------------
-- 10. MAIN REAL-TIME LOOP
-- ------------------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
    local sg = getScreenGui()
    if not sg then return end
    
    -- [1] ตรวจสอบ Dodge
    local dodgeBtn = sg:FindFirstChild("dodgebut")
    local dodgeActive = isDodgePromptActive(dodgeBtn)
    
    if dodgeActive then
        if Config.AutoDodge and not hasDodgedThisPrompt then
            if Config.DodgeDelay <= 0 then
                executeDodge()
            else
                task.delay(Config.DodgeDelay, executeDodge)
            end
        end
    else
        hasDodgedThisPrompt = false
    end
    
    -- [2] ตรวจสอบ Slap (ปั๊มปุ่ม SLAP จังหวะธรรมชาติ เนียนตา ปั๊มเต็ม 100% ทุกรอบ)
    local slapReady = isSlapPromptActive()
    
    if slapReady then
        if Config.AutoSlap and Config.AutoMashSlap and not hasSlappedThisTurn and not isSlappingNow then
            performNaturalBurstSlap()
        end
    else
        -- เมื่อปุ่ม SLAP หายไป หรือเปลี่ยนเป็น Wait... หรือเข้าสู่ช่วงทาย ให้รีเซ็ตสถานะทันที พร้อมสำหรับรอบถัดไป 100%
        if not isSlappingNow then
            hasSlappedThisTurn = false
        end
    end
    
    -- [3] สแกนตรวจจับคนตบ
    if Config.NotifyAttacker then
        scanArenaForSlapper()
    end
    
    -- [4] ตรวจสอบป้าย Suspects
    checkAndHighlightSuspects()
    
    -- [5] Auto Save Streak
    if Config.AutoSaveStreak then
        local saveFrame = sg:FindFirstChild("SaveStreakFrame")
        if saveFrame and saveFrame.Visible then
            local yesBtn = saveFrame:FindFirstChild("yes")
            if yesBtn then
                pcall(function() if firesignal then firesignal(yesBtn.MouseButton1Click) end end)
            else
                pcall(function() Remotes.SaveStreak:FireServer() end)
            end
        end
    end
end)

