-- ระบบแจ้งเตือนแบบป้องกันสแปมเด็ดขาด (Anti-Spam Debounce)
local lastNotifyText = ""
local lastNotifyTime = 0

local function notifyOnce(title, text, duration)
    local now = tick()
    -- ป้องกันข้อความเดิมเด้งซ้ำภายใน 25 วินาทีเด็ดขาด
    if text == lastNotifyText and (now - lastNotifyTime < 25) then 
        return 
    end
    if now - lastNotifyTime < 6 then 
        return 
    end
    
    lastNotifyText = text
    lastNotifyTime = now
    
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "[TANG HUB] " .. title,
            Text = text,
            Duration = duration or 3,
        })
    end)
end

